    <string name="breathing_method_478_name">4–7–8 助眠呼吸法</string>
    <string name="breathing_method_478_subtitle">主推・失眠首选</string>
    <string name="breathing_method_478_desc">哈佛医学院安德鲁・韦尔博士研发，被称为「天然生理安眠药」。超长呼气强制降低心率、减少大脑皮层活跃度，快速缓解睡前胡思乱想、入睡困难、夜间易醒。坚持2周可大幅缩短入睡时长。</string>
    <string name="breathing_method_478_step1">平躺放松，舌尖轻抵上颚，先用嘴巴彻底吐尽空气</string>
    <string name="breathing_method_478_step2">闭紧嘴巴，鼻子轻柔吸气4秒，腹部自然鼓起</string>
    <string name="breathing_method_478_step3">屏住气息7秒，全身保持松弛不紧绷</string>
    <string name="breathing_method_478_step4">嘴唇微张，缓慢呼气8秒，呼气可发出轻柔\'嘶\'风声</string>
    <string name="breathing_method_478_step5">循环4–8轮，思绪飘走只需轻轻拉回呼吸即可</string>
    <string name="breathing_method_478_tag1">睡前助眠</string>
    <string name="breathing_method_478_tag2">深度助眠</string>
    <string name="breathing_method_478_tag3">深夜放松</string>
    <string name="breathing_method_box_name">箱式呼吸</string>
    <string name="breathing_method_box_subtitle">方形呼吸・平衡专注</string>
    <string name="breathing_method_box_desc">美国海豹突击队抗压训练法，四方均等呼吸节奏，像画正方形得名。平衡交感与副交感神经，缓解心慌、烦躁、职场高压。放松同时不会产生困倦，适合午休、工作间隙、考前平复情绪。</string>
    <string name="breathing_method_box_step1">腰背挺直坐好或平躺，全身放松</string>
    <string name="breathing_method_box_step2">鼻子匀速吸气4秒，腹部扩张</string>
    <string name="breathing_method_box_step3">屏住气息4秒，内心保持平静</string>
    <string name="breathing_method_box_step4">鼻子缓慢呼气4秒，排空肺部空气</string>
    <string name="breathing_method_box_step5">呼气结束后短暂屏息4秒，完整一轮循环</string>
    <string name="breathing_method_box_tag1">日间减压</string>
    <string name="breathing_method_box_tag2">静心专注</string>
    <string name="breathing_method_box_tag3">情绪稳定</string>
    <string name="breathing_method_belly_name">基础腹式呼吸</string>
    <string name="breathing_method_belly_subtitle">入门通用・新手友好</string>
    <string name="breathing_method_belly_desc">无固定计时节奏，所有呼吸法的底层基础，零基础零门槛。用横膈膜呼吸，而非胸腔呼吸。改善浅短急促的浅呼吸习惯，缓解长期胸闷、焦虑、疲劳。随时随地可练习，适合呼吸新手、轻度焦虑人群。</string>
    <string name="breathing_method_belly_step1">一手放在胸口、一手放在腹部</string>
    <string name="breathing_method_belly_step2">鼻缓慢吸气，只有腹部鼓起，胸口保持不动</string>
    <string name="breathing_method_belly_step3">嘴匀速呼气，腹部向内收紧下沉</string>
    <string name="breathing_method_belly_step4">全程缓慢绵长，呼气时长尽量为吸气的1.5–2倍，自由循环</string>
    <string name="breathing_method_belly_tag1">新手入门</string>
    <string name="breathing_method_belly_tag2">日常舒缓</string>
    <string name="breathing_method_belly_tag3">放松基底</string>
    <string name="breathing_method_426_name">4–2–6 快速减压呼吸</string>
    <string name="breathing_method_426_subtitle">短时舒缓・紧张时刻</string>
    <string name="breathing_method_426_desc">轻量化短节奏，适合突发心慌、情绪崩溃、睡前烦躁，门槛极低。快速下调压力激素皮质醇，1分钟内平复心跳加速、紧张手抖，适合通勤、开会前、情绪失控时快速缓冲。</string>
    <string name="breathing_method_426_step1">闭眼放松肩膀，鼻子吸气4秒</string>
    <string name="breathing_method_426_step2">短暂屏息2秒，不刻意憋气</string>
    <string name="breathing_method_426_step3">拉长呼气至6秒，把烦躁、压力全部呼出</string>
